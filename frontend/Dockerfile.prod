# ==========================================
# 1. Build Stage
# ==========================================
FROM node:18-alpine AS builder

WORKDIR /app

# Instalar dependencias primero (cache)
COPY package*.json ./
RUN npm install

# Copiar código fuente
COPY . .

# Variables de entorno para el build
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Compilar para producción (React Router + Vite)
RUN npm run build

# ==========================================
# 2. Production Stage
# ==========================================
FROM nginx:alpine

# Copiar los archivos construidos desde el builder
# Como Vite fue configurado con base='/vehiculos/', los assets están en dist/ pero las rutas HTML apuntan a /vehiculos/...
COPY --from=builder /app/dist /usr/share/nginx/html

# Copiar archivo de configuración nginx personalizado
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
